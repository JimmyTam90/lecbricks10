# OPTIONAL. If unset on Vercel, the build uses VERCEL_PROJECT_PRODUCTION_URL automatically.
# Must be the REAL hostname of THIS Spoke project (check Vercel -> Project -> Domains).
# Your Vercel project is named "lecbricks10", so the host is probably https://lecbricks10.vercel.app
SPOKE_PROJECT_URL=
# Optional tracking IDs (empty = NOT_CONFIGURED; never invent IDs)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
